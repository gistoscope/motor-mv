{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "declarationMap": false,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@motor/core": [
        "../core/dist/index.d.ts"
      ],
      "@motor/core/*": [
        "../core/dist/*"
      ],
      "@motor/parser": [
        "../parser/dist/index.d.ts"
      ],
      "@motor/parser/*": [
        "../parser/dist/*"
      ]
    }
  },
  "references": [
    {
      "path": "../core/tsconfig.build.json"
    },
    {
      "path": "../parser/tsconfig.build.json"
    }
  ],
  "include": [
    "src/**/*"
  ]
}